# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Database (Supabase Postgres) ─────────────────────────
# Supabase dashboard → Connect → ORMs / connection strings.
# Pooled (transaction pooler, port 6543) — used by the running app:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=app"
# Direct / session pooler (port 5432) — used by prisma migrate & seed:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app"
DATABASE_SCHEMA=app

# ── Google OAuth ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI (through the FRONTEND's /api proxy, so the session cookie
# belongs to the website's origin): http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Optional: only allow Google accounts from this Workspace domain (e.g. yourorg.com)
GOOGLE_ALLOWED_DOMAIN=

# ── Sessions & security ──────────────────────────────────
SESSION_COOKIE_NAME=teamos_session
SESSION_TTL_HOURS=168
# 32+ random characters. Encrypts Master Admin TOTP secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Development-only email login (ignored when NODE_ENV=production).
AUTH_DEV_LOGIN=false

# ── Seed ─────────────────────────────────────────────────
SEED_ORGANIZATION_NAME=TEAM OS
SEED_MASTER_ADMIN_EMAIL=
SEED_MASTER_ADMIN_NAME=Master Admin
# Initial secondary code for the hidden Master Admin gateway (rotate it from the console).
SEED_GATEWAY_CODE=

# ── Google Drive (file storage for Phase 4) ──────────────
# Uses the same OAuth client. Enable the Drive API in Google Cloud Console and add
# this redirect URI to the client:
#   http://localhost:3000/api/integrations/google-drive/callback
# Master Admin then connects the organization's Drive from the console.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# ── Google Calendar (organization Schedule) ──────────────
# Same OAuth client. Enable the Google Calendar API and add this redirect URI to the client.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
