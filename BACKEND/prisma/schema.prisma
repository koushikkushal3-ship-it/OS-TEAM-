// TEAM OS — Phase 1 data model (Foundation)
// Tables live in the `app` Postgres schema (set via ?schema=app / adapter option),
// so they are not exposed through Supabase's public Data API.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Organization
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  departments         Department[]
  users               User[]
  roles               Role[]
  teams               Team[]
  events              Event[]
  permissionOverrides PermissionOverride[]
  tasks               Task[]
  meetings            Meeting[]
  files               FileRecord[]
  budgets             Budget[]
  expenses            Expense[]
  tickets             Ticket[]
  ideas               Idea[]
  opportunities       Opportunity[]
  customModules       CustomModule[]
  customRecords       CustomRecord[]
  auditLogs           AuditLog[]
  settings            OrganizationSetting[]

  @@map("organizations")
}

model OrganizationSetting {
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@map("organization_settings")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentTree")
  users        User[]
  roles        Role[]
  teams        Team[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────
// People & sessions
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  departmentId   String?    @map("department_id") @db.Uuid
  email          String     @unique
  name           String
  avatarUrl      String?    @map("avatar_url")
  googleSubject  String?    @unique @map("google_subject")
  status         UserStatus @default(INVITED)
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions             Session[]
  roles                UserRole[]            @relation("UserRoles")
  teamMemberships      TeamMember[]
  eventMembers         EventMember[]
  ownedEvents          Event[]               @relation("EventOwner")
  tasksCreated         Task[]                @relation("TaskCreator")
  tasksAssigned        Task[]                @relation("TaskAssignee")
  workUpdates          TaskUpdate[]          @relation("WorkUpdateAuthor")
  meetingsCreated      Meeting[]             @relation("MeetingCreator")
  meetings             MeetingParticipant[]
  meetingSessions      ParticipantSession[]
  decisions            MeetingDecision[]     @relation("DecisionAuthor")
  actionItems          MeetingActionItem[]   @relation("ActionOwner")
  reviewedUpdates      TaskUpdate[]          @relation("WorkUpdateReviewer")
  files                FileRecord[]          @relation("FileUploader")
  expensesPaid         Expense[]             @relation("ExpensePayer")
  expensesSubmitted    Expense[]             @relation("ExpenseSubmitter")
  expensesReviewed     Expense[]             @relation("ExpenseReviewer")
  ticketsRequested     Ticket[]              @relation("TicketRequester")
  ticketsAssigned      Ticket[]              @relation("TicketAssignee")
  ticketActivity       TicketActivity[]
  ideasSubmitted       Idea[]                @relation("IdeaAuthor")
  ideasReviewed        Idea[]                @relation("IdeaReviewer")
  opportunitiesOwned   Opportunity[]         @relation("OpportunityOwner")
  opportunitiesCreated Opportunity[]         @relation("OpportunityCreator")
  opportunityActivity  OpportunityActivity[]
  customModules        CustomModule[]        @relation("CustomModuleAuthor")
  customRecordsOwned   CustomRecord[]        @relation("CustomRecordOwner")
  customRecordsCreated CustomRecord[]        @relation("CustomRecordAuthor")
  adminMfa             AdminMfa?
  calendarToken        String?               @unique @map("calendar_token")
  notifications        Notification[]
  kudosGiven           Kudos[]               @relation("KudosFrom")
  kudosReceived        Kudos[]               @relation("KudosTo")
  leaveRequests        LeaveRequest[]        @relation("LeaveRequester")
  leaveReviewed        LeaveRequest[]        @relation("LeaveReviewer")
  shifts               ShiftAssignment[]
  runItems             RunItem[]
  auditLogs            AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  ip                String?
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  // Master Admin gateway state
  gatewayVerifiedAt DateTime? @map("gateway_verified_at")
  privilegedUntil   DateTime? @map("privileged_until")
  impersonatorId    String?   @map("impersonator_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AdminMfa {
  userId          String    @id @map("user_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  enabledAt       DateTime? @map("enabled_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_mfa")
}

// ─────────────────────────────────────────────────────────────
// Roles & permissions (custom role engine — nothing hard-coded)
// ─────────────────────────────────────────────────────────────

model Role {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  reportsToRoleId String?  @map("reports_to_role_id") @db.Uuid
  key             String
  name            String
  description     String?
  // System roles cannot be deleted (their permissions can still be edited).
  isSystem        Boolean  @default(false) @map("is_system")
  // Holders are eligible for the hidden Master Admin control plane.
  isMasterAdmin   Boolean  @default(false) @map("is_master_admin")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  reportsTo    Role?            @relation("RoleHierarchy", fields: [reportsToRoleId], references: [id], onDelete: SetNull)
  reports      Role[]           @relation("RoleHierarchy")
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Module {
  key         String       @id
  name        String
  description String?
  // Core modules (people, teams, events…) cannot be disabled.
  isCore      Boolean      @default(false) @map("is_core")
  phase       Int
  status      ModuleStatus @default(PLANNED)
  version     String       @default("0.1.0")
  navigation  Json?
  config      Json?
  updatedAt   DateTime     @updatedAt @map("updated_at")

  permissions Permission[]

  @@map("modules")
}

enum ModuleStatus {
  ENABLED
  DISABLED
  PLANNED
}

model Permission {
  key         String  @id // e.g. "finance.approve"
  moduleKey   String  @map("module_key")
  description String?

  module Module           @relation(fields: [moduleKey], references: [key])
  roles  RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @map("role_id") @db.Uuid
  permissionKey String @map("permission_key")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

enum RoleScope {
  ORGANIZATION
  DEPARTMENT
  TEAM
  EVENT
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  // Contextual access: a role can apply org-wide or only inside one department/team/event.
  scopeType    RoleScope @default(ORGANIZATION) @map("scope_type")
  scopeId      String?   @map("scope_id") @db.Uuid
  assignedById String?   @map("assigned_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@map("user_roles")
}

enum OverrideScope {
  GLOBAL
  ORGANIZATION
  DEPARTMENT
  TEAM
  EVENT
  ROLE
  USER
}

enum OverrideEffect {
  ALLOW
  DENY
}

// Configuration hierarchy: GLOBAL → ORGANIZATION → DEPARTMENT → TEAM → EVENT → ROLE → USER.
// permissionKey may be exact ("finance.approve") or a module wildcard ("finance.*").
model PermissionOverride {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  scopeType      OverrideScope  @map("scope_type")
  // "global" for GLOBAL, otherwise the id of the org/department/team/event/role/user.
  scopeId        String         @map("scope_id")
  permissionKey  String         @map("permission_key")
  effect         OverrideEffect
  expiresAt      DateTime?      @map("expires_at")
  note           String?
  createdById    String?        @map("created_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeType, scopeId, permissionKey])
  @@map("permission_overrides")
}

// ─────────────────────────────────────────────────────────────
// Teams & events (many-to-many)
// ─────────────────────────────────────────────────────────────

model Team {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members       TeamMember[]
  events        EventTeam[]
  tasks         Task[]
  meetings      Meeting[]
  budgets       Budget[]
  expenses      Expense[]
  tickets       Ticket[]
  ideas         Idea[]
  opportunities Opportunity[]
  customRecords CustomRecord[]

  @@unique([organizationId, name])
  @@map("teams")
}

enum TeamMemberRole {
  LEAD
  CO_LEAD
  MEMBER
}

model TeamMember {
  teamId     String         @map("team_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  memberRole TeamMemberRole @default(MEMBER) @map("member_role")
  joinedAt   DateTime       @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

enum EventStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

model Event {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  ownerId        String?     @map("owner_id") @db.Uuid
  name           String
  description    String?
  venue          String?
  startDate      DateTime?   @map("start_date")
  endDate        DateTime?   @map("end_date")
  budget         Decimal?    @db.Decimal(14, 2)
  status         EventStatus @default(PLANNING)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner         User?          @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teams         EventTeam[]
  members       EventMember[]
  tasks         Task[]
  meetings      Meeting[]
  budgets       Budget[]
  expenses      Expense[]
  tickets       Ticket[]
  ideas         Idea[]
  opportunities Opportunity[]
  customRecords CustomRecord[]
  shifts        Shift[]
  runItems      RunItem[]

  @@map("events")
}

model EventTeam {
  eventId String   @map("event_id") @db.Uuid
  teamId  String   @map("team_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([eventId, teamId])
  @@map("event_teams")
}

model EventMember {
  eventId String   @map("event_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  role    String?
  addedAt DateTime @default(now()) @map("added_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_members")
}

// ─────────────────────────────────────────────────────────────
// Governance
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ip             String?
  userAgent      String?  @map("user_agent")
  sessionId      String?  @map("session_id") @db.Uuid
  privileged     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─────────────────────────────────────────────────────────────
// Phase 2 — Work management
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  BACKLOG
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  eventId        String?      @map("event_id") @db.Uuid
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  title          String
  description    String?
  createdById    String?      @map("created_by_id") @db.Uuid
  assignedToId   String?      @map("assigned_to_id") @db.Uuid
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(BACKLOG)
  /// 0–100, kept in step with the latest work update
  percentage     Int          @default(0)
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  completedAt    DateTime?    @map("completed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?              @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  parentTask   Task?              @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]             @relation("Subtasks")
  createdBy    User?              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  actionItem   MeetingActionItem?
  assignedTo   User?              @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  updates      TaskUpdate[]

  @@index([organizationId, status])
  @@index([assignedToId, status])
  @@index([teamId])
  @@index([eventId])
  @@map("tasks")
}

/// Daily work update — the complete history of a task (arch doc §19).
model TaskUpdate {
  id           String     @id @default(uuid()) @db.Uuid
  taskId       String     @map("task_id") @db.Uuid
  userId       String?    @map("user_id") @db.Uuid
  percentage   Int
  summary      String
  blockers     String?
  /// Status the task moved to with this update.
  status       TaskStatus
  /// Lead review of this update.
  reviewedById String?    @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?  @map("reviewed_at")
  reviewNote   String?    @map("review_note")
  createdAt    DateTime   @default(now()) @map("created_at")

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User? @relation("WorkUpdateAuthor", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("WorkUpdateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@map("task_updates")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Meeting Center & attendance
// ─────────────────────────────────────────────────────────────

enum MeetingType {
  GOOGLE_MEET
  INTERNAL
  PHYSICAL
  WORKSHOP
  ONE_TO_ONE
  EXTERNAL
  EVENT
  CUSTOM
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

/// How the meeting link/attendance data is produced. GOOGLE_MEET_API is filled in
/// when the organization connects a Google Workspace account.
enum MeetingProvider {
  MANUAL
  /// Reserved: an embedded in-portal video room. Not used — the organization
  /// joins video through a pasted Google Meet link instead.
  IN_PORTAL
  GOOGLE_MEET_LINK
  GOOGLE_MEET_API
}

enum ParticipantRole {
  HOST
  CO_HOST
  REQUIRED
  OPTIONAL
}

enum AttendanceStatus {
  UNKNOWN
  PRESENT
  LATE
  PARTIAL
  ABSENT
  EXCUSED
}

enum SessionSource {
  PROVIDER
  MANUAL
  SELF
}

model Meeting {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  teamId               String?         @map("team_id") @db.Uuid
  eventId              String?         @map("event_id") @db.Uuid
  title                String
  description          String?
  type                 MeetingType     @default(INTERNAL)
  status               MeetingStatus   @default(SCHEDULED)
  provider             MeetingProvider @default(MANUAL)
  /// Video room name for the in-portal call; also the space id for a future Meet API sync.
  providerSpaceId      String?         @map("provider_space_id")
  providerConferenceId String?         @map("provider_conference_id")
  joinUrl              String?         @map("join_url")
  location             String?
  agenda               String?
  notes                String?
  scheduledStart       DateTime        @map("scheduled_start")
  scheduledEnd         DateTime        @map("scheduled_end")
  startedAt            DateTime?       @map("started_at")
  endedAt              DateTime?       @map("ended_at")
  createdById          String?         @map("created_by_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdBy    User?                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  sessions     ParticipantSession[]
  decisions    MeetingDecision[]
  actionItems  MeetingActionItem[]

  @@index([organizationId, scheduledStart])
  @@index([teamId])
  @@index([eventId])
  @@map("meetings")
}

model MeetingParticipant {
  meetingId    String           @map("meeting_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         ParticipantRole  @default(REQUIRED)
  status       AttendanceStatus @default(UNKNOWN)
  /// True when a lead set the status by hand instead of deriving it from sessions.
  statusManual Boolean          @default(false) @map("status_manual")
  firstJoinAt  DateTime?        @map("first_join_at")
  lastLeaveAt  DateTime?        @map("last_leave_at")
  minutes      Int              @default(0)
  note         String?
  addedAt      DateTime         @default(now()) @map("added_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

/// One join/leave pair. Rejoins create extra rows (arch doc §27).
model ParticipantSession {
  id        String        @id @default(uuid()) @db.Uuid
  meetingId String        @map("meeting_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  joinedAt  DateTime      @map("joined_at")
  leftAt    DateTime?     @map("left_at")
  source    SessionSource @default(MANUAL)
  createdAt DateTime      @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId, userId])
  @@map("participant_sessions")
}

model MeetingDecision {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  text        String
  decidedById String?  @map("decided_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("DecisionAuthor", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_decisions")
}

/// Action item from a meeting; becomes a Phase 2 task when an owner is set.
model MeetingActionItem {
  id        String    @id @default(uuid()) @db.Uuid
  meetingId String    @map("meeting_id") @db.Uuid
  text      String
  ownerId   String?   @map("owner_id") @db.Uuid
  dueDate   DateTime? @map("due_date")
  taskId    String?   @unique @map("task_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   User?   @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_action_items")
}

// ─────────────────────────────────────────────────────────────
// Phase 4 — Operations
// ─────────────────────────────────────────────────────────────

/// A file stored in the organization's Google Drive, linked to any record.
/// TEAM OS keeps the metadata; Drive keeps the bytes (arch doc §32).
model FileRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// "expense", "idea", "ticket", "opportunity", "meeting", "task"…
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  driveFileId    String   @map("drive_file_id")
  name           String
  mimeType       String   @map("mime_type")
  size           Int
  /// Kind of document: INVOICE, PAYMENT_PROOF, PROPOSAL, ATTACHMENT…
  kind           String   @default("ATTACHMENT")
  uploadedById   String?  @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("files")
}

// ── Finance ──────────────────────────────────────────────────

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REIMBURSED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String?  @map("event_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  name           String
  amount         Decimal  @db.Decimal(14, 2)
  notes          String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  expenses     Expense[]

  @@index([organizationId])
  @@map("budgets")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  eventId           String?       @map("event_id") @db.Uuid
  teamId            String?       @map("team_id") @db.Uuid
  budgetId          String?       @map("budget_id") @db.Uuid
  title             String
  category          String
  amount            Decimal       @db.Decimal(14, 2)
  /// Who actually paid and should be reimbursed.
  paidById          String?       @map("paid_by_id") @db.Uuid
  paymentMethod     PaymentMethod @default(UPI) @map("payment_method")
  spentAt           DateTime      @map("spent_at")
  description       String?
  status            ExpenseStatus @default(SUBMITTED)
  submittedById     String?       @map("submitted_by_id") @db.Uuid
  reviewedById      String?       @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?     @map("reviewed_at")
  firstApprovedById String?       @map("first_approved_by_id") @db.Uuid
  reviewNote        String?       @map("review_note")
  reimbursedAt      DateTime?     @map("reimbursed_at")
  reimbursedRef     String?       @map("reimbursed_ref")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  budget       Budget?      @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  paidBy       User?        @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: SetNull)
  submittedBy  User?        @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("ExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([eventId])
  @@map("expenses")
}

// ── Tickets ──────────────────────────────────────────────────

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  teamId         String?        @map("team_id") @db.Uuid
  eventId        String?        @map("event_id") @db.Uuid
  /// Human-friendly number, unique inside the organization.
  number         Int
  title          String
  description    String?
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  requesterId    String?        @map("requester_id") @db.Uuid
  assigneeId     String?        @map("assignee_id") @db.Uuid
  resolution     String?
  resolvedAt     DateTime?      @map("resolved_at")
  closedAt       DateTime?      @map("closed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  requester    User?            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee     User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activity     TicketActivity[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("tickets")
}

model TicketActivity {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// "comment", or a state change such as "status" or "assignee".
  kind      String   @default("comment")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_activity")
}

// ── Ideas ────────────────────────────────────────────────────

enum IdeaStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  IMPLEMENTING
  IMPLEMENTED
}

/// Structured, document-based idea submission — deliberately not a chat (arch doc §33).
model Idea {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  eventId        String?    @map("event_id") @db.Uuid
  teamId         String?    @map("team_id") @db.Uuid
  title          String
  category       String
  summary        String
  status         IdeaStatus @default(SUBMITTED)
  submittedById  String?    @map("submitted_by_id") @db.Uuid
  reviewedById   String?    @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?  @map("reviewed_at")
  decisionNote   String?    @map("decision_note")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submittedBy  User?        @relation("IdeaAuthor", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy   User?        @relation("IdeaReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("ideas")
}

// ── Opportunities: sponsors, guests, vendors, venues, partners ──

enum OpportunityType {
  SPONSOR
  GUEST
  VENDOR
  VENUE
  COLLABORATION
  INVITATION
  PARTNER
}

enum OpportunityStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  NEGOTIATING
  CONFIRMED
  REJECTED
  CLOSED
}

/// One pipeline for everyone the organization works with (arch doc §34).
model Opportunity {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  eventId          String?           @map("event_id") @db.Uuid
  teamId           String?           @map("team_id") @db.Uuid
  type             OpportunityType
  name             String
  organizationName String?           @map("organization_name")
  contactName      String?           @map("contact_name")
  contactEmail     String?           @map("contact_email")
  contactPhone     String?           @map("contact_phone")
  description      String?
  /// Sponsorship amount, vendor quote, venue price…
  value            Decimal?          @db.Decimal(14, 2)
  status           OpportunityStatus @default(NEW)
  ownerId          String?           @map("owner_id") @db.Uuid
  nextActionAt     DateTime?         @map("next_action_at")
  createdById      String?           @map("created_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team         Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner        User?                 @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?                 @relation("OpportunityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activity     OpportunityActivity[]

  @@index([organizationId, type, status])
  @@index([eventId])
  @@map("opportunities")
}

model OpportunityActivity {
  id            String   @id @default(uuid()) @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  kind          String   @default("note")
  message       String
  createdAt     DateTime @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([opportunityId, createdAt])
  @@map("opportunity_activity")
}

// ─────────────────────────────────────────────────────────────
// Phase 6 — Platform builder (custom modules)
// ─────────────────────────────────────────────────────────────

/**
 * A module Master Admin created at runtime (arch doc §12). It registers a row in
 * `modules` and its own `permissions`, so roles, overrides and the enable switch
 * all work on it exactly like a built-in module — no code change, no redeploy.
 */
model CustomModule {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Matches the `modules.key` row this definition owns, e.g. "custom_sponsorship_tracker".
  moduleKey      String   @unique @map("module_key")
  name           String
  description    String?
  /// Lucide icon name shown in navigation.
  icon           String   @default("Blocks")
  /// Field definitions: [{ key, label, type, required, options }]
  fields         Json
  /// Workflow states the records move through, in order.
  statuses       Json
  /// Records can be attached to an event and/or a team.
  scopeEvent     Boolean  @default(true) @map("scope_event")
  scopeTeam      Boolean  @default(true) @map("scope_team")
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?          @relation("CustomModuleAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  records      CustomRecord[]

  @@unique([organizationId, name])
  @@map("custom_modules")
}

/// One row inside a custom module. Field values live in `data`, shaped by the definition.
model CustomRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customModuleId String   @map("custom_module_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  eventId        String?  @map("event_id") @db.Uuid
  title          String
  status         String
  data           Json
  ownerId        String?  @map("owner_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customModule CustomModule @relation(fields: [customModuleId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  owner        User?        @relation("CustomRecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("CustomRecordAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([customModuleId, status])
  @@index([organizationId, createdAt])
  @@map("custom_records")
}

// ─────────────────────────────────────────────────────────────
// Platform features: notifications, people, operations, control
// ─────────────────────────────────────────────────────────────

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  title          String
  body           String?
  link           String?
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Announcement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String
  body           String
  /// ORGANIZATION, DEPARTMENT, TEAM or EVENT
  scopeType      String    @default("ORGANIZATION") @map("scope_type")
  scopeId        String?   @map("scope_id") @db.Uuid
  tone           String    @default("info")
  startsAt       DateTime  @default(now()) @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, startsAt])
  @@map("announcements")
}

model Kudos {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromId         String   @map("from_id") @db.Uuid
  toId           String   @map("to_id") @db.Uuid
  message        String
  createdAt      DateTime @default(now()) @map("created_at")

  from User @relation("KudosFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("KudosTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([toId])
  @@map("kudos")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           String      @default("Leave")
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  reason         String?
  status         LeaveStatus @default(PENDING)
  reviewedById   String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?   @map("reviewed_at")
  reviewNote     String?     @map("review_note")
  createdAt      DateTime    @default(now()) @map("created_at")

  user       User  @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, startDate])
  @@map("leave_requests")
}

model Shift {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  title          String
  location       String?
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  capacity       Int      @default(1)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([eventId, startsAt])
  @@map("shifts")
}

model ShiftAssignment {
  shiftId   String   @map("shift_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([shiftId, userId])
  @@index([userId])
  @@map("shift_assignments")
}

/// One line of an event's run-of-show for the day itself.
model RunItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  title          String
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  ownerId        String?   @map("owner_id") @db.Uuid
  notes          String?
  doneAt         DateTime? @map("done_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([eventId, startsAt])
  @@map("event_run_items")
}

enum ChangeRequestStatus {
  PENDING
  EXECUTED
  REJECTED
  CANCELLED
}

/// Two-person rule: a dangerous change waits for a second Master Admin.
model ChangeRequest {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  kind           String
  summary        String
  payload        Json
  status         ChangeRequestStatus @default(PENDING)
  requestedById  String              @map("requested_by_id") @db.Uuid
  decidedById    String?             @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?           @map("decided_at")
  error          String?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([organizationId, status])
  @@map("change_requests")
}

/// Recycle bin: a snapshot of a deleted row, restorable for 30 days.
model DeletedRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id")
  label          String
  snapshot       Json
  deletedById    String?   @map("deleted_by_id") @db.Uuid
  deletedAt      DateTime  @default(now()) @map("deleted_at")
  restoredAt     DateTime? @map("restored_at")
  /// Set when Master Admin chose "Ignore": the deletion is accepted but still restorable until purged.
  reviewedAt     DateTime? @map("reviewed_at")
  reviewedById   String?   @map("reviewed_by_id") @db.Uuid

  @@index([organizationId, deletedAt])
  @@map("deleted_records")
}

model AutomationRule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  trigger        String
  /// Trigger parameters, e.g. { "days": 2 } or { "minAmount": 10000 }
  config         Json
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  firings AutomationFiring[]

  @@map("automation_rules")
}

/// Remembers which record a rule already fired for, so nobody is alerted twice.
model AutomationFiring {
  ruleId   String   @map("rule_id") @db.Uuid
  entityId String   @map("entity_id")
  firedAt  DateTime @default(now()) @map("fired_at")

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([ruleId, entityId])
  @@map("automation_firings")
}

/// Organization schedule: written by admins, Master Admin and leads, read by everyone it is meant for.
/// Mirrored into a Google Calendar when that integration is connected.
model ScheduleEntry {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  title           String
  description     String?
  location        String?
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  allDay          Boolean   @default(false) @map("all_day")
  /// ORGANIZATION, DEPARTMENT, TEAM or EVENT
  scopeType       String    @default("ORGANIZATION") @map("scope_type")
  scopeId         String?   @map("scope_id") @db.Uuid
  category        String    @default("General")
  createdById     String?   @map("created_by_id") @db.Uuid
  updatedById     String?   @map("updated_by_id") @db.Uuid
  googleEventId   String?   @map("google_event_id")
  googleSyncedAt  DateTime? @map("google_synced_at")
  googleSyncError String?   @map("google_sync_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([organizationId, startsAt])
  @@map("schedule_entries")
}
